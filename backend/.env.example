# NO ENTRY Backend Environment Variables (Keep real keys ONLY in backend/.env - never commit)
SECRET_KEY=
DATABASE_URL="sqlite:///./data/no_entry.db"

# Multi-Provider AI Priority Order
AI_PROVIDER_PRIORITY="groq,gemini,openrouter"
AI_REQUEST_TIMEOUT_SEC=20
AI_MAX_RETRIES=1

# Provider API Keys (Models are resolved dynamically by each provider adapter)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
HF_TOKEN=

# Rate Limiting
GHOST_RATE_LIMIT_PER_HOUR=20
GHOST_VOICE_RATE_LIMIT_PER_HOUR=30
