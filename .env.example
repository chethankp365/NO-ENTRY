# NO ENTRY Environment Configuration (Copy to backend/.env and add keys locally)
APP_NAME="NO ENTRY"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security & Auth (Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default SQLite; optional PostgreSQL URL supported via psycopg)
DATABASE_URL="sqlite:///./data/no_entry.db"

# Simulation
AUTOPILOT_ENABLED=true
EVENT_INTERVAL_MIN=1.0
EVENT_INTERVAL_MAX=3.5

# Multi-Provider AI Orchestration (Ghost Mentor)
AI_PROVIDER_PRIORITY="groq,gemini,openrouter"
AI_REQUEST_TIMEOUT_SEC=20
AI_MAX_RETRIES=1

# Provider API Keys (Models are automatically resolved per provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
HF_TOKEN=

# Ghost Rate Limits (Per Operator Per Hour)
GHOST_RATE_LIMIT_PER_HOUR=20
GHOST_VOICE_RATE_LIMIT_PER_HOUR=30
